### 텔레그램 봇 클라이언트
```python
# backend/src/telegram/notifications.py
import asyncio
from telegram import Bot
import logging
from typing import Dict, Optional

class TelegramNotifier:
    def __init__(self, bot_token: str, chat_id: str):
        self.bot = Bot(token=bot_token)
        self.chat_id = chat_id
        self.logger = logging.getLogger(__name__)
    
    async def send_trade_notification(self, trade_data: Dict):
        """거래 알림 발송"""
        try:
            side = "매수" if trade_data['side'] == 'bid' else "매도"
            message = f"""
🔔 거래 체결 알림

📊 종목: {trade_data['market']}
💱 구분: {side}
💰 가격: {trade_data['price']:,.0f} KRW
📦 수량: {trade_data['volume']:.6f}
💵 총액: {trade_data['total_amount']:,.0f} KRW
⏰ 시간: {trade_data['timestamp']}

#{trade_data['market'].replace('-', '')} #거래체결
"""
            
            await self.bot.send_message(
                chat_id=self.chat_id,
                text=message,
                parse_mode='HTML'
            )
            
            self.logger.info(f"텔레그램 알림 발송 완료: {trade_data['market']}")
            
        except Exception as e:
            self.logger.error(f"텔레그램 알림 발송 오류: {e}")
    
    async def send_error_notification(self, error_message: str):
        """오류 알림 발송"""
        try:
            message = f"""
🚨 시스템 오류 알림

❌ {error_message}
⏰ {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}

#오류알림
"""
            
            await self.bot.send_message(
                chat_id=self.chat_id,
                text=message
            )
            
        except Exception as e:
            self.logger.error(f"오류 알림 발송 실패: {e}")
    
    async def send_daily_summary(self, summary_data: Dict):
        """일일 거래 요약 발송"""
        try:
            message = f"""
📈 일일 거래 요약

📅 날짜: {summary_data['date']}
💰 총 거래금액: {summary_data['total_amount']:,.0f} KRW
📊 거래 횟수: {summary_data['trade_count']}회
💹 실현 수익: {summary_data['realized_profit']:,.0f} KRW
📈 수익률: {summary_data['profit_rate']:.2f}%

#일일요약
"""
            
            await self.bot.send_message(
                chat_id=self.chat_id,
                text=message
            )
            
        except Exception as e:
            self.logger.error(f"일일 요약 발송 오류: {e}")
```

## ⚠️ API 사용 시 주의사항

### 1. Rate Limiting
- **Quotation API**: 10 requests/sec, 600 requests/min
- **WebSocket**: 5 requests/sec, 100 requests/min
- 요청 간격 조절 필수

### 2. 오류 처리
```python
def handle_api_error(func):
    """API 오류 처리 데코레이터"""
    def wrapper(*args, **kwargs):
        try:
            return func(*args, **kwargs)
        except Exception as e:
            if "Too Many Requests" in str(e):
                time.sleep(1)  # Rate limit 대기
                return func(*args, **kwargs)
            else:
                raise e
    return wrapper
```

### 3. 보안 고려사항
- API 키를 코드에 하드코딩하지 않음
- 환경 변수로 민감한 정보 관리
- HTTPS 통신 필수
- 주문 전 잔고 확인 필수

### 4. 테스트 환경
