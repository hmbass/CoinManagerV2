## 🤖 Upbit API 클라이언트 구현

### 기본 API 클라이언트
```python
# backend/src/api/upbit_client.py
import pyupbit
import asyncio
from typing import Dict, List, Optional
from decimal import Decimal
import logging

class UpbitClient:
    def __init__(self, access_key: str, secret_key: str):
        self.access_key = access_key
        self.secret_key = secret_key
        self.upbit = pyupbit.Upbit(access_key, secret_key)
        self.logger = logging.getLogger(__name__)
    
    def get_balances(self) -> List[Dict]:
        """계좌 잔고 조회"""
        try:
            return self.upbit.get_balances()
        except Exception as e:
            self.logger.error(f"잔고 조회 오류: {e}")
            return []
    
    def get_current_price(self, ticker: str) -> Optional[float]:
        """현재가 조회"""
        try:
            return pyupbit.get_current_price(ticker)
        except Exception as e:
            self.logger.error(f"현재가 조회 오류 ({ticker}): {e}")
            return None
    
    def buy_market_order(self, ticker: str, price: float) -> Optional[Dict]:
        """시장가 매수 주문"""
        try:
            result = self.upbit.buy_market_order(ticker, price)
            self.logger.info(f"매수 주문 실행: {ticker}, 금액: {price}")
            return result
        except Exception as e:
            self.logger.error(f"매수 주문 오류 ({ticker}): {e}")
            return None
    
    def sell_market_order(self, ticker: str, volume: float) -> Optional[Dict]:
        """시장가 매도 주문"""
        try:
            result = self.upbit.sell_market_order(ticker, volume)
            self.logger.info(f"매도 주문 실행: {ticker}, 수량: {volume}")
            return result
        except Exception as e:
            self.logger.error(f"매도 주문 오류 ({ticker}): {e}")
            return None
    
    def buy_limit_order(self, ticker: str, price: float, volume: float) -> Optional[Dict]:
        """지정가 매수 주문"""
        try:
            result = self.upbit.buy_limit_order(ticker, price, volume)
            self.logger.info(f"지정가 매수 주문: {ticker}, 가격: {price}, 수량: {volume}")
            return result
        except Exception as e:
            self.logger.error(f"지정가 매수 주문 오류 ({ticker}): {e}")
            return None
    
    def sell_limit_order(self, ticker: str, price: float, volume: float) -> Optional[Dict]:
        """지정가 매도 주문"""
        try:
            result = self.upbit.sell_limit_order(ticker, price, volume)
            self.logger.info(f"지정가 매도 주문: {ticker}, 가격: {price}, 수량: {volume}")
            return result
        except Exception as e:
            self.logger.error(f"지정가 매도 주문 오류 ({ticker}): {e}")
            return None
    
    def cancel_order(self, uuid: str) -> Optional[Dict]:
        """주문 취소"""
        try:
            result = self.upbit.cancel_order(uuid)
            self.logger.info(f"주문 취소: {uuid}")
            return result
        except Exception as e:
            self.logger.error(f"주문 취소 오류 ({uuid}): {e}")
            return None
    
    def get_order_status(self, uuid: str) -> Optional[Dict]:
        """주문 상태 조회"""
        try:
            return self.upbit.get_order(uuid)
        except Exception as e:
            self.logger.error(f"주문 상태 조회 오류 ({uuid}): {e}")
            return None
```

## 📊 실시간 데이터 수신

### WebSocket 클라이언트
```python
# backend/src/api/websocket.py
import asyncio
import json
import websockets
from typing import Callable, List
import logging

class UpbitWebSocketClient:
    def __init__(self, tickers: List[str], callback: Callable):
        self.tickers = tickers
        self.callback = callback
        self.logger = logging.getLogger(__name__)
        self.ws = None
        self.running = False
    
    async def connect(self):
        """WebSocket 연결"""
        uri = "wss://api.upbit.com/websocket/v1"
        
        # 구독 메시지 생성
        subscribe_message = [
            {"ticket": "test"},
            {
                "type": "ticker",
                "codes": self.tickers,
                "isOnlySnapshot": False,
                "isOnlyRealtime": True
            }
        ]
        
        try:
            self.ws = await websockets.connect(uri)
            await self.ws.send(json.dumps(subscribe_message))
            self.running = True
            self.logger.info(f"WebSocket 연결 성공: {self.tickers}")
            
            # 메시지 수신 루프
            async for message in self.ws:
                if not self.running:
                    break
                
                try:
                    data = json.loads(message.decode('utf-8'))
                    await self.callback(data)
                except Exception as e:
                    self.logger.error(f"메시지 처리 오류: {e}")
                    
        except Exception as e:
            self.logger.error(f"WebSocket 연결 오류: {e}")
        finally:
            if self.ws:
                await self.ws.close()
    
    async def disconnect(self):
        """WebSocket 연결 해제"""
        self.running = False
        if self.ws:
            await self.ws.close()
            self.logger.info("WebSocket 연결 해제")
```

## 💰 거래 전략 구현

### 기본 단타 전략
```python
# backend/src/trading/strategies/scalping_strategy.py
from typing import Dict, Optional
import pandas as pd
import numpy as np
from datetime import datetime, timedelta

class ScalpingStrategy:
    def __init__(self, config: Dict):
        self.min_profit_percent = config.get('min_profit_percent', 0.5)
        self.max_loss_percent = config.get('max_loss_percent', 0.3)
        self.volume_threshold = config.get('volume_threshold', 1000000)
        self.rsi_oversold = config.get('rsi_oversold', 30)
        self.rsi_overbought = config.get('rsi_overbought', 70)
    
    def should_buy(self, market_data: Dict) -> bool:
        """매수 신호 판단"""
        try:
            # 기본 조건 확인
            current_price = market_data.get('trade_price', 0)
            volume = market_data.get('acc_trade_volume_24h', 0)
            
            # 거래량 조건
            if volume < self.volume_threshold:
                return False
            
            # 추가 기술적 지표 확인 (예: RSI, 이동평균 등)
            # 실제 구현에서는 pyupbit.get_ohlcv()로 데이터 가져와서 계산
            
            # 간단한 예시: 가격 변동률 기준
            change_rate = market_data.get('signed_change_rate', 0)
            
            # 하락 후 반등 신호
            if change_rate < -0.02 and self._is_oversold(market_data):
                return True
                
            return False
            
        except Exception as e:
            print(f"매수 신호 판단 오류: {e}")
            return False
    
    def should_sell(self, position: Dict, current_price: float) -> bool:
        """매도 신호 판단"""
        try:
            entry_price = position.get('avg_buy_price', 0)
            if entry_price == 0:
                return False
            
            # 수익률 계산
            profit_rate = (current_price - entry_price) / entry_price * 100
            
            # 익절 조건
            if profit_rate >= self.min_profit_percent:
                return True
            
            # 손절 조건
            if profit_rate <= -self.max_loss_percent:
                return True
            
            return False
            
        except Exception as e:
            print(f"매도 신호 판단 오류: {e}")
            return False
    
    def _is_oversold(self, market_data: Dict) -> bool:
        """과매도 상태 확인 (간단한 구현)"""
        # 실제로는 RSI 등의 기술적 지표 사용
        change_rate = market_data.get('signed_change_rate', 0)
        return change_rate < -0.03
```

