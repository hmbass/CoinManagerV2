## 🛡️ 보안 가이드라인

### 1. API 키 보안
```python
# ❌ 잘못된 예시 - 코드에 직접 하드코딩
API_KEY = "your_api_key_here"  # 절대 금지!

# ✅ 올바른 예시 - 환경 변수 사용
import os
from pydantic_settings import BaseSettings

class Settings(BaseSettings):
    upbit_access_key: str
    upbit_secret_key: str
    
    class Config:
        env_file = ".env"
        case_sensitive = True

settings = Settings()
```

### 2. 데이터 암호화
```python
# src/utils/crypto.py
from cryptography.fernet import Fernet
import os

class DataEncryption:
    def __init__(self):
        key = os.getenv('ENCRYPTION_KEY')
        if not key:
            raise ValueError("ENCRYPTION_KEY 환경 변수가 설정되지 않았습니다")
        
        self.fernet = Fernet(key.encode())
    
    def encrypt(self, data: str) -> str:
        """데이터 암호화"""
        return self.fernet.encrypt(data.encode()).decode()
    
    def decrypt(self, encrypted_data: str) -> str:
        """데이터 복호화"""
        return self.fernet.decrypt(encrypted_data.encode()).decode()

# 사용 예시
encryption = DataEncryption()

# 민감한 정보 암호화 저장
encrypted_api_key = encryption.encrypt(settings.upbit_access_key)

# 필요시 복호화
decrypted_api_key = encryption.decrypt(encrypted_api_key)
```

### 3. API 접근 제한
```python
# src/api/middleware.py
from fastapi import Request, HTTPException, status
from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
import time
from collections import defaultdict

# Rate Limiting
class RateLimiter:
    def __init__(self, requests_per_minute: int = 100):
        self.requests_per_minute = requests_per_minute
        self.requests = defaultdict(list)
    
    def is_allowed(self, client_ip: str) -> bool:
        now = time.time()
        minute_ago = now - 60
        
        # 1분 이전 요청 제거
        self.requests[client_ip] = [
            req_time for req_time in self.requests[client_ip] 
            if req_time > minute_ago
        ]
        
        # 현재 요청 추가
        self.requests[client_ip].append(now)
        
        # 제한 확인
        return len(self.requests[client_ip]) <= self.requests_per_minute

rate_limiter = RateLimiter(requests_per_minute=100)

async def rate_limit_middleware(request: Request, call_next):
    client_ip = request.client.host
    
    if not rate_limiter.is_allowed(client_ip):
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS,
            detail="Rate limit exceeded"
        )
    
    response = await call_next(request)
    return response
```

### 4. 입력 데이터 검증
```python
# src/schemas/trade.py
from pydantic import BaseModel, validator, Field
from typing import Optional
from decimal import Decimal

class TradeCreateRequest(BaseModel):
    market: str = Field(..., regex=r'^[A-Z]+-[A-Z]+$')
    side: str = Field(..., regex=r'^(buy|sell)$')
    amount: Decimal = Field(..., gt=0, le=1000000)
    
    @validator('market')
    def validate_market(cls, v):
        allowed_markets = ['KRW-BTC', 'KRW-ETH', 'KRW-XRP']
        if v not in allowed_markets:
            raise ValueError(f'지원되지 않는 마켓: {v}')
        return v
    
    @validator('amount')
    def validate_amount(cls, v):
        if v < 5000:  # 최소 주문 금액
            raise ValueError('최소 주문 금액은 5,000원입니다')
        return v

class TradeResponse(BaseModel):
    id: int
    market: str
    side: str
    amount: Decimal
    price: Decimal
    created_at: datetime
    
    class Config:
        from_attributes = True
```

