### 2. 단위 테스트 예시
```python
# tests/unit/test_trading_strategy.py
import pytest
from src.trading.strategies.scalping import ScalpingStrategy

@pytest.mark.asyncio
async def test_scalping_strategy_should_buy():
    """스캘핑 전략 매수 신호 테스트"""
    strategy = ScalpingStrategy()
    
    # 하락 신호 데이터
    market_data = {
        'signed_change_rate': -0.025,  # 2.5% 하락
        'acc_trade_volume_24h': 2000000,  # 충분한 거래량
        'trade_price': 50000
    }
    
    result = await strategy.should_buy(market_data)
    assert result is True
    
    # 상승 신호 데이터
    market_data['signed_change_rate'] = 0.01  # 1% 상승
    result = await strategy.should_buy(market_data)
    assert result is False

@pytest.mark.asyncio
async def test_scalping_strategy_should_sell():
    """스캘핑 전략 매도 신호 테스트"""
    strategy = ScalpingStrategy({
        'min_profit_percent': 0.5,
        'max_loss_percent': 0.3
    })
    
    market_data = {'trade_price': 50500}  # 현재가
    position = {'avg_buy_price': 50000}   # 평균 매수가
    
    # 익절 조건 (1% 수익)
    result = await strategy.should_sell(market_data, position)
    assert result is True
    
    # 손절 조건
    market_data['trade_price'] = 49850  # 0.3% 손실
    result = await strategy.should_sell(market_data, position)
    assert result is True
    
    # 보유 조건
    market_data['trade_price'] = 50100  # 0.2% 수익
    result = await strategy.should_sell(market_data, position)
    assert result is False
