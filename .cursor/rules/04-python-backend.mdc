## 🚀 FastAPI 애플리케이션 구조

### 1. 메인 애플리케이션
```python
# src/main.py
import asyncio
from contextlib import asynccontextmanager
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from fastapi.middleware.gzip import GZipMiddleware

from .api.main import api_router
from .config import settings
from .database.connection import init_db
from .trading.engine import TradingEngine
from .telegram.bot import TelegramBot
from .utils.logger import setup_logger

# 전역 인스턴스들
trading_engine = None
telegram_bot = None
logger = setup_logger(__name__)

@asynccontextmanager
async def lifespan(app: FastAPI):
    """애플리케이션 생명주기 관리"""
    global trading_engine, telegram_bot
    
    try:
        # 시작 시 초기화
        logger.info("애플리케이션 시작 중...")
        
        # 데이터베이스 초기화
        await init_db()
        
        # 트레이딩 엔진 시작
        if settings.TRADING_ENABLED:
            trading_engine = TradingEngine()
            await trading_engine.start()
            logger.info("트레이딩 엔진 시작됨")
        
        # 텔레그램 봇 시작
        if settings.TELEGRAM_ENABLED:
            telegram_bot = TelegramBot()
            await telegram_bot.start()
            logger.info("텔레그램 봇 시작됨")
        
        logger.info("애플리케이션 시작 완료")
        
        yield
        
    finally:
        # 종료 시 정리
        logger.info("애플리케이션 종료 중...")
        
        if trading_engine:
            await trading_engine.stop()
            logger.info("트레이딩 엔진 중지됨")
        
        if telegram_bot:
            await telegram_bot.stop()
            logger.info("텔레그램 봇 중지됨")
        
        logger.info("애플리케이션 종료 완료")

# FastAPI 앱 생성
app = FastAPI(
    title="CoinTrader API",
    description="단타 코인 트레이딩 시스템 API",
    version="1.0.0",
    lifespan=lifespan
)

# 미들웨어 추가
app.add_middleware(
    CORSMiddleware,
    allow_origins=settings.ALLOWED_ORIGINS,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)
app.add_middleware(GZipMiddleware, minimum_size=1000)

# API 라우터 등록
app.include_router(api_router, prefix="/api/v1")

@app.get("/")
async def root():
    return {"message": "CoinTrader API Server", "status": "running"}

@app.get("/health")
async def health_check():
    return {
        "status": "healthy",
        "trading_engine": trading_engine.is_running if trading_engine else False,
        "telegram_bot": telegram_bot.is_running if telegram_bot else False
    }
```

