# src/telegram/notifications.py
import asyncio
from typing import Dict
from telegram import Bot
from telegram.error import TelegramError
import logging

from ..config import settings

class TelegramNotifier:
    def __init__(self):
        self.bot = Bot(token=settings.TELEGRAM_BOT_TOKEN)
        self.chat_id = settings.TELEGRAM_CHAT_ID
        self.logger = logging.getLogger(__name__)
    
    async def send_trade_notification(self, trade_data: Dict):
        """거래 체결 알림"""
        try:
            side_emoji = "🟢" if trade_data['side'] == 'buy' else "🔴"
            side_text = "매수" if trade_data['side'] == 'buy' else "매도"
            
            message = f"""
{side_emoji} **거래 체결 알림**

📊 **종목**: `{trade_data['market']}`
💱 **구분**: {side_text}
💰 **가격**: {trade_data['price']:,.0f} KRW
📦 **수량**: {trade_data['volume']:.6f}
💵 **총액**: {trade_data['amount']:,.0f} KRW
🎯 **전략**: {trade_data['strategy']}
⏰ **시간**: {trade_data['timestamp'].strftime('%Y-%m-%d %H:%M:%S')}

#{trade_data['market'].replace('-', '')} #거래체결
"""
            
            await self.bot.send_message(
                chat_id=self.chat_id,
                text=message,
                parse_mode='Markdown'
            )
            
            self.logger.info(f"거래 알림 발송 완료: {trade_data['market']}")
            
        except TelegramError as e:
            self.logger.error(f"텔레그램 알림 발송 오류: {e}")
        except Exception as e:
            self.logger.error(f"알림 처리 오류: {e}")
    
    async def send_error_notification(self, error_message: str):
        """오류 알림"""
        try:
            message = f"""
🚨 **시스템 오류 알림**

❌ {error_message}
⏰ {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}

#오류알림
"""
            
            await self.bot.send_message(
                chat_id=self.chat_id,
                text=message,
                parse_mode='Markdown'
            )
            
        except Exception as e:
            self.logger.error(f"오류 알림 발송 실패: {e}")
    
    async def send_daily_summary(self, summary_data: Dict):
        """일일 거래 요약"""
        try:
            profit_emoji = "📈" if summary_data['total_profit'] > 0 else "📉"
            
            message = f"""
{profit_emoji} **일일 거래 요약**

📅 **날짜**: {summary_data['date']}
💰 **총 거래금액**: {summary_data['total_amount']:,.0f} KRW
📊 **거래 횟수**: {summary_data['trade_count']}회
💹 **실현 수익**: {summary_data['total_profit']:+,.0f} KRW
📈 **수익률**: {summary_data['profit_rate']:+.2f}%
🎯 **승률**: {summary_data['win_rate']:.1f}%

#일일요약
"""
            
            await self.bot.send_message(
                chat_id=self.chat_id,
                text=message,
                parse_mode='Markdown'
            )
            
        except Exception as e:
            self.logger.error(f"일일 요약 발송 오류: {e}")
```

## 🗃️ 데이터베이스 모델

### 1. SQLAlchemy 모델
```python
# src/database/models.py
from sqlalchemy import Column, Integer, String, Float, DateTime, Boolean, Text
from sqlalchemy.ext.declarative import declarative_base
from sqlalchemy.sql import func
from datetime import datetime

Base = declarative_base()

class Trade(Base):
    __tablename__ = "trades"
    
    id = Column(Integer, primary_key=True, index=True)
    market = Column(String(20), nullable=False, index=True)  # KRW-BTC
    side = Column(String(10), nullable=False)  # buy, sell
    order_type = Column(String(20), nullable=False)  # market, limit
    price = Column(Float, nullable=False)
    volume = Column(Float, nullable=False)
    amount = Column(Float, nullable=False)  # price * volume
    fee = Column(Float, default=0.0)
    strategy = Column(String(50))  # 사용된 전략
    upbit_uuid = Column(String(100), unique=True)  # Upbit 주문 UUID
    
    # 성과 관련
    profit_loss = Column(Float, default=0.0)
    profit_rate = Column(Float, default=0.0)
    
    # 메타 정보
    notes = Column(Text)
    created_at = Column(DateTime(timezone=True), server_default=func.now())
    updated_at = Column(DateTime(timezone=True), onupdate=func.now())

class TradingConfig(Base):
    __tablename__ = "trading_configs"
    
    id = Column(Integer, primary_key=True, index=True)
    name = Column(String(100), nullable=False)  # 설정 이름
    
    # 거래 설정
    enabled = Column(Boolean, default=True)
    trading_mode = Column(String(10), default="paper")  # live, paper
    markets = Column(Text)  # JSON 문자열로 저장
    
    # 리스크 관리
    max_position_size = Column(Float, default=100000.0)
    stop_loss_percent = Column(Float, default=3.0)
    take_profit_percent = Column(Float, default=2.0)
    max_daily_loss = Column(Float, default=50000.0)
    
    # 전략 설정
    strategy_config = Column(Text)  # JSON 문자열
    
    created_at = Column(DateTime(timezone=True), server_default=func.now())
    updated_at = Column(DateTime(timezone=True), onupdate=func.now())

class Portfolio(Base):
    __tablename__ = "portfolio"
    
    id = Column(Integer, primary_key=True, index=True)
    market = Column(String(20), nullable=False, unique=True)
    
    # 포지션 정보
    volume = Column(Float, default=0.0)  # 보유 수량
    avg_buy_price = Column(Float, default=0.0)  # 평균 매수가
    total_amount = Column(Float, default=0.0)  # 총 투자금액
    
    # 성과 정보
    unrealized_profit = Column(Float, default=0.0)  # 미실현 손익
    realized_profit = Column(Float, default=0.0)  # 실현 손익
    
    updated_at = Column(DateTime(timezone=True), onupdate=func.now())

class SystemLog(Base):
    __tablename__ = "system_logs"
    
    id = Column(Integer, primary_key=True, index=True)
    level = Column(String(10), nullable=False)  # INFO, WARNING, ERROR
    module = Column(String(100))  # 로그 발생 모듈
    message = Column(Text, nullable=False)
    details = Column(Text)  # 추가 상세 정보
    
    created_at = Column(DateTime(timezone=True), server_default=func.now())
```

