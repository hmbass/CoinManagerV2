## 📈 거래 엔진 구현

### 1. 메인 트레이딩 엔진
```python
# src/trading/engine.py
import asyncio
from typing import Dict, List, Optional
from datetime import datetime
import logging

from ..upbit.client import UpbitClient
from ..upbit.websocket import UpbitWebSocketClient
from ..database.repositories.trade_repository import TradeRepository
from ..telegram.notifications import TelegramNotifier
from .strategies.base import BaseStrategy
from .strategies.scalping import ScalpingStrategy
from .risk_manager import RiskManager
from .order_manager import OrderManager
from .portfolio import Portfolio

class TradingEngine:
    def __init__(self):
        self.upbit_client = UpbitClient()
        self.trade_repository = TradeRepository()
        self.telegram_notifier = TelegramNotifier()
        
        self.risk_manager = RiskManager()
        self.order_manager = OrderManager(self.upbit_client)
        self.portfolio = Portfolio()
        
        # 거래 전략 초기화
        self.strategies: Dict[str, BaseStrategy] = {
            'scalping': ScalpingStrategy()
        }
        
        self.websocket_client = None
        self.is_running = False
        self.logger = logging.getLogger(__name__)
    
    async def start(self):
        """트레이딩 엔진 시작"""
        if self.is_running:
            return
        
        self.logger.info("트레이딩 엔진 시작 중...")
        
        try:
            # 포트폴리오 초기화
            await self.portfolio.initialize()
            
            # WebSocket 연결 시작
            self.websocket_client = UpbitWebSocketClient(
                tickers=[settings.DEFAULT_MARKET],
                callback=self._on_market_data
            )
            
            # WebSocket 연결을 별도 태스크로 실행
            asyncio.create_task(self.websocket_client.connect())
            
            self.is_running = True
            self.logger.info("트레이딩 엔진 시작 완료")
            
        except Exception as e:
            self.logger.error(f"트레이딩 엔진 시작 오류: {e}")
            raise
    
    async def stop(self):
        """트레이딩 엔진 중지"""
        if not self.is_running:
            return
        
        self.logger.info("트레이딩 엔진 중지 중...")
        
        self.is_running = False
        
        if self.websocket_client:
            await self.websocket_client.disconnect()
        
        self.logger.info("트레이딩 엔진 중지 완료")
    
    async def _on_market_data(self, data: Dict):
        """시장 데이터 수신 시 콜백"""
        if not self.is_running:
            return
        
        try:
            ticker = data.get('code', '')
            
            # 각 전략에 대해 신호 확인
            for strategy_name, strategy in self.strategies.items():
                if await strategy.should_trade(data):
                    await self._execute_strategy(strategy_name, strategy, data)
                    
        except Exception as e:
            self.logger.error(f"시장 데이터 처리 오류: {e}")
    
    async def _execute_strategy(self, strategy_name: str, strategy: BaseStrategy, data: Dict):
        """거래 전략 실행"""
        try:
            ticker = data.get('code', '')
            current_price = data.get('trade_price', 0)
            
            # 리스크 검증
            if not await self.risk_manager.validate_trade(ticker, current_price):
                return
            
            # 매수 신호 확인
            if await strategy.should_buy(data):
                amount = await self.risk_manager.calculate_position_size(current_price)
                order_result = await self.order_manager.place_buy_order(ticker, amount)
                
                if order_result:
                    await self._handle_order_result('buy', order_result, strategy_name)
            
            # 매도 신호 확인 (기존 포지션이 있는 경우)
            position = await self.portfolio.get_position(ticker)
            if position and await strategy.should_sell(data, position):
                order_result = await self.order_manager.place_sell_order(ticker, position['volume'])
                
                if order_result:
                    await self._handle_order_result('sell', order_result, strategy_name)
                    
        except Exception as e:
            self.logger.error(f"전략 실행 오류 ({strategy_name}): {e}")
    
    async def _handle_order_result(self, side: str, order_result: Dict, strategy_name: str):
        """주문 결과 처리"""
        try:
            # 데이터베이스에 거래 기록 저장
            trade_data = {
                'market': order_result['market'],
                'side': side,
                'price': float(order_result['price']),
                'volume': float(order_result['volume']),
                'amount': float(order_result['price']) * float(order_result['volume']),
                'strategy': strategy_name,
                'timestamp': datetime.now()
            }
            
            await self.trade_repository.create_trade(trade_data)
            
            # 포트폴리오 업데이트
            await self.portfolio.update_position(order_result)
            
            # 텔레그램 알림 발송
            await self.telegram_notifier.send_trade_notification(trade_data)
            
            self.logger.info(f"거래 완료: {side} {order_result['market']} at {order_result['price']}")
            
        except Exception as e:
            self.logger.error(f"주문 결과 처리 오류: {e}")
```

### 2. 거래 전략 구현
```python
# src/trading/strategies/base.py
from abc import ABC, abstractmethod
from typing import Dict, Optional

class BaseStrategy(ABC):
    """기본 거래 전략 추상 클래스"""
    
    def __init__(self, config: Optional[Dict] = None):
        self.config = config or {}
    
    @abstractmethod
    async def should_buy(self, market_data: Dict) -> bool:
        """매수 신호 판단"""
        pass
    
    @abstractmethod
    async def should_sell(self, market_data: Dict, position: Dict) -> bool:
        """매도 신호 판단"""
        pass
    
    async def should_trade(self, market_data: Dict) -> bool:
        """거래 가능 여부 판단 (기본 필터링)"""
        # 기본적인 필터링 로직
        volume = market_data.get('acc_trade_volume_24h', 0)
        min_volume = self.config.get('min_volume', 1000000)
        
        return volume >= min_volume

# src/trading/strategies/scalping.py
from .base import BaseStrategy
from typing import Dict

class ScalpingStrategy(BaseStrategy):
    """스캘핑 전략"""
    
    def __init__(self, config: Dict = None):
        default_config = {
            'rsi_oversold': 30,
            'rsi_overbought': 70,
            'min_profit_percent': 0.5,
            'max_loss_percent': 0.3,
            'min_volume': 1000000
        }
        
        if config:
            default_config.update(config)
        
        super().__init__(default_config)
    
    async def should_buy(self, market_data: Dict) -> bool:
        """매수 신호 판단"""
        try:
            # 급격한 하락 후 반등 신호 감지
            change_rate = market_data.get('signed_change_rate', 0)
            
            # 2% 이상 하락 시 매수 고려
            if change_rate <= -0.02:
                # 추가 기술적 지표 확인 가능
                return True
            
            return False
            
        except Exception:
            return False
    
    async def should_sell(self, market_data: Dict, position: Dict) -> bool:
        """매도 신호 판단"""
        try:
            current_price = market_data.get('trade_price', 0)
            entry_price = position.get('avg_buy_price', 0)
            
            if entry_price == 0:
                return False
            
            profit_rate = (current_price - entry_price) / entry_price * 100
            
            # 익절 조건
            if profit_rate >= self.config['min_profit_percent']:
                return True
            
            # 손절 조건
            if profit_rate <= -self.config['max_loss_percent']:
                return True
            
            return False
            
        except Exception:
            return False
