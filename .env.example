# ==============================================
# CoinTrader 환경 변수 설정 예시
# 이 파일을 .env로 복사하고 실제 값으로 변경하세요
# ==============================================

# ==============================================
# 🔑 필수 API 인증 정보 (절대 공유 금지)
# ==============================================

# Upbit API 설정 (https://upbit.com/mypage/open_api_management)
UPBIT_ACCESS_KEY=your_upbit_access_key_here
UPBIT_SECRET_KEY=your_upbit_secret_key_here
UPBIT_SERVER_URL=https://api.upbit.com

# 텔레그램 봇 설정 (BotFather에서 생성)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ENABLED=true
TELEGRAM_NOTIFICATIONS_ENABLED=true

# ==============================================
# 🌐 환경 및 서버 설정
# ==============================================

# 환경 구분 (development, staging, production)
ENVIRONMENT=development
DEBUG=true

# API 서버 설정
API_HOST=localhost
API_PORT=8000
API_DEBUG=false
API_WORKERS=1

# CORS 설정 (Frontend URL 포함)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ==============================================
# 🗄️ 데이터베이스 설정
# ==============================================

# 개발환경 (SQLite)
DATABASE_URL=sqlite:///./data/trading.db

# 프로덕션환경 (PostgreSQL) - 필요시 주석 해제
# DATABASE_URL=postgresql://username:password@localhost:5432/cointrader

# Redis (캐싱 및 세션) - 선택사항
REDIS_URL=redis://localhost:6379/0

# ==============================================
# 💰 거래 설정
# ==============================================

# 거래 활성화
TRADING_ENABLED=true
TRADING_MODE=paper  # "live" 또는 "paper" (모의거래)

# 기본 거래 설정
DEFAULT_MARKET=KRW-BTC
MIN_ORDER_AMOUNT=5000
MAX_POSITION_SIZE=100000
MAX_CONCURRENT_POSITIONS=3
POSITION_SIZE_PERCENT=10.0

# 리스크 관리
STOP_LOSS_PERCENT=3.0
TAKE_PROFIT_PERCENT=2.0
MAX_DAILY_LOSS=50000

# ==============================================
# 📊 거래 전략 설정
# ==============================================

# 스캘핑 전략
SCALPING_ENABLED=true
SCALPING_RSI_OVERSOLD=30
SCALPING_RSI_OVERBOUGHT=70
SCALPING_MIN_VOLUME=1000000
SCALPING_MIN_PROFIT=0.5
SCALPING_MAX_LOSS=0.3

# 모멘텀 전략 (향후 확장용)
MOMENTUM_ENABLED=false
MOMENTUM_PERIOD=20
MOMENTUM_THRESHOLD=2.0

# ==============================================
# 📱 알림 설정
# ==============================================

# 알림 유형별 설정
NOTIFICATION_TRADE_ALERTS=true
NOTIFICATION_ERROR_ALERTS=true
NOTIFICATION_DAILY_SUMMARY=true
NOTIFICATION_SYSTEM_STATUS=true

# 알림 주기 설정
DAILY_SUMMARY_TIME=21:00  # 21시에 일일 요약 발송
SYSTEM_CHECK_INTERVAL=300  # 5분마다 시스템 상태 확인

# ==============================================
# 📋 로깅 설정
# ==============================================

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=detailed  # simple, detailed

# 로그 파일 설정
LOG_FILE=logs/trading.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5
LOG_ROTATION=daily

# 특별 로그 설정
TRADE_LOG_ENABLED=true
TRADE_LOG_FILE=logs/trades.log
ERROR_LOG_ENABLED=true
ERROR_LOG_FILE=logs/errors.log

# ==============================================
# 🔒 보안 설정
# ==============================================

# JWT 토큰 (API 인증용) - 32자 이상 랜덤 문자열
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_to_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# 암호화 키 (32바이트 Base64 인코딩) - 민감 데이터 암호화용
ENCRYPTION_KEY=your_32_byte_base64_encoded_encryption_key_here

# API 보안
API_RATE_LIMIT=100  # 분당 요청 제한
API_RATE_LIMIT_WINDOW=60  # 제한 시간 윈도우 (초)

# 세션 보안
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# ==============================================
# 🧪 개발 및 테스트 설정
# ==============================================

# 개발 모드
DEVELOPMENT_MODE=true
DEBUG_API_CALLS=false
MOCK_UPBIT_API=false

# 테스트 설정
TEST_DATABASE_URL=sqlite:///:memory:
TEST_TELEGRAM_DISABLED=true
TEST_TRADING_DISABLED=true

# ==============================================
# 📈 모니터링 및 성능
# ==============================================

# 성능 모니터링
PERFORMANCE_MONITORING=true
METRICS_ENDPOINT_ENABLED=true
HEALTH_CHECK_INTERVAL=60

# 데이터 수집 및 보존
MARKET_DATA_RETENTION_DAYS=30
TRADE_DATA_RETENTION_DAYS=365
LOG_RETENTION_DAYS=90

# ==============================================
# 🔄 백업 및 복구
# ==============================================

# 자동 백업 설정
AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# 데이터베이스 백업
DB_BACKUP_ENABLED=true
DB_BACKUP_TIME=02:00  # 새벽 2시에 백업

# ==============================================
# 🚀 배포 설정 (GCP/클라우드용)
# ==============================================

# 외부 서비스 설정
EXTERNAL_API_TIMEOUT=30
EXTERNAL_API_RETRY_COUNT=3
EXTERNAL_API_RETRY_DELAY=1

# Docker 설정 (선택사항)
DOCKER_COMPOSE_ENV=development
CONTAINER_NAME=cointrader-backend

# ==============================================
# 📝 설정 가이드
# ==============================================

# 1. 필수 설정 항목 (반드시 변경):
#    - UPBIT_ACCESS_KEY, UPBIT_SECRET_KEY
#    - TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
#    - JWT_SECRET_KEY, ENCRYPTION_KEY

# 2. 보안 키 생성 방법:
#    JWT_SECRET_KEY: openssl rand -base64 32
#    ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# 3. 텔레그램 봇 설정:
#    - BotFather(@BotFather)에서 봇 생성
#    - /start 명령으로 채팅 시작
#    - 채팅 ID 확인: https://api.telegram.org/bot\<TOKEN\>/getUpdates

# 4. Upbit API 키 발급:
#    - Upbit 로그인 > 마이페이지 > Open API 관리
#    - 자산조회, 주문조회, 주문하기 권한 필요

# 5. 거래 모드:
#    - paper: 모의거래 (실제 주문 없음, 로그만 출력)
#    - live: 실거래 (실제 자금 사용, 신중히 설정)

# 6. 로그 확인:
#    - 거래 로그: tail -f logs/trades.log
#    - 시스템 로그: tail -f logs/trading.log
#    - 오류 로그: tail -f logs/errors.log
